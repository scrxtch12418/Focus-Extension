{
    "manifest_version": 3,
    "name": "Focus Command Center",
    "version": "1.0",
    "description": "All-in-one media, pomodoro, and article focus tool.",
    "permissions": [
        "sidePanel",
        "tabs",
        "storage",
        "scripting",
        "declarativeNetRequest",
        "notifications",
        "activeTab",
        "offscreen",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel/index.html"
    },
    "action": {
        "default_title": "Open Focus Center",
        "default_popup": "sidepanel/index.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "sidepanel/content.js"
            ]
        }
    ]
}