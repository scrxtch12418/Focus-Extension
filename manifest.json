{
    "manifest_version": 3,
    "name": "Focus Command Center",
    "version": "1.1",
    "description": "All-in-one Pomodoro timer, ambient soundscapes, anti-doomscroll blocker, and article focus dashboard.",
    "permissions": [
        "sidePanel",
        "tabs",
        "storage",
        "scripting",
        "declarativeNetRequest",
        "notifications",
        "activeTab",
        "offscreen",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "commands": {
        "toggle_timer": {
            "suggested_key": {
                "default": "Alt+Shift+F",
                "mac": "Alt+Shift+F"
            },
            "description": "Start or pause focus timer"
        },
        "toggle_audio": {
            "suggested_key": {
                "default": "Alt+Shift+M",
                "mac": "Alt+Shift+M"
            },
            "description": "Toggle ambient soundscapes & lofi"
        },
        "clean_article": {
            "suggested_key": {
                "default": "Alt+Shift+Z",
                "mac": "Alt+Shift+Z"
            },
            "description": "Toggle Zen Reader (Clean Article) on active page"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel/index.html"
    },
    "action": {
        "default_title": "Open Focus Center",
        "default_popup": "sidepanel/index.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "sidepanel/content.js"
            ]
        }
    ]
}